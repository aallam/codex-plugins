#!/usr/bin/env python3
"""Run a structured, read-only Claude review of Git changes."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import queue
import shutil
import subprocess
import sys
import threading
import time
from typing import Any, Sequence, TextIO


DEFAULT_MAX_DIFF_BYTES = 400_000
DEFAULT_MAX_BUDGET_USD = 2.0
DEFAULT_TIMEOUT_SECONDS = 600
MAX_ARTIFACT_BYTES = 1_000_000
MAX_FOLLOW_UP_REVIEW_BYTES = 100_000
ARTIFACT_SCHEMA_VERSION = 1
REVIEWER_ID = "claude"
PROGRESS_INTERVAL_SECONDS = 30
READ_ONLY_TOOLS = "Read,Glob,Grep"
PROGRESS_TOOLS = frozenset(READ_ONLY_TOOLS.split(","))
REVIEW_PATHS = [
    ".",
    ":(exclude,glob).env",
    ":(exclude,glob).env.*",
    ":(exclude,glob)**/.env",
    ":(exclude,glob)**/.env.*",
    ":(exclude,glob)**/.envrc",
    ":(exclude,glob)**/.netrc",
    ":(exclude,glob)**/.npmrc",
    ":(exclude,glob)**/.pypirc",
    ":(exclude,glob)**/*.pem",
    ":(exclude,glob)**/*.key",
    ":(exclude,glob)**/*.p12",
    ":(exclude,glob)**/*.pfx",
    ":(exclude,glob)**/*.jks",
    ":(exclude,glob)**/*.keystore",
    ":(exclude,glob)**/*.kdbx",
    ":(exclude,glob)**/id_rsa",
    ":(exclude,glob)**/id_ed25519",
    ":(exclude,glob)**/*credentials*.json",
    ":(exclude,glob)**/*secret*.json",
    ":(exclude,glob)**/*secret*.yaml",
    ":(exclude,glob)**/*secret*.yml",
]
REVIEW_SCHEMA: dict[str, Any] = {
    "type": "object",
    "additionalProperties": False,
    "required": ["verdict", "summary", "findings", "coverage_gaps", "next_steps"],
    "properties": {
        "verdict": {
            "type": "string",
            "enum": ["approve", "approve_with_notes", "request_changes"],
        },
        "summary": {"type": "string"},
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": [
                    "severity",
                    "title",
                    "file",
                    "line",
                    "evidence",
                    "recommendation",
                    "confidence",
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^F[0-9]{3}$",
                    },
                    "severity": {
                        "type": "string",
                        "enum": ["blocker", "high", "medium", "low"],
                    },
                    "title": {"type": "string"},
                    "file": {"type": "string"},
                    "line": {
                        "anyOf": [
                            {"type": "integer", "minimum": 1},
                            {"type": "null"},
                        ]
                    },
                    "evidence": {"type": "string"},
                    "recommendation": {"type": "string"},
                    "confidence": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                    },
                },
            },
        },
        "coverage_gaps": {
            "type": "array",
            "items": {"type": "string"},
        },
        "next_steps": {
            "type": "array",
            "items": {"type": "string"},
        },
    },
}


class ReviewError(RuntimeError):
    """A user-actionable review failure."""


def utc_now() -> str:
    """Return an RFC 3339 UTC timestamp suitable for artifact metadata."""
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def default_artifacts_dir(repo_root: Path) -> Path:
    """Keep local review artifacts inside Git metadata, including in worktrees."""
    dot_git = repo_root / ".git"
    if dot_git.is_dir():
        git_dir = dot_git
    elif dot_git.is_file():
        marker = dot_git.read_text(encoding="utf-8").strip()
        if not marker.startswith("gitdir: "):
            raise ReviewError(f"Could not resolve Git metadata from {dot_git}.")
        candidate = Path(marker.removeprefix("gitdir: "))
        git_dir = candidate if candidate.is_absolute() else (repo_root / candidate)
    else:
        raise ReviewError(f"Could not find Git metadata for {repo_root}.")
    return git_dir.resolve() / "codex-reviews" / REVIEWER_ID


def resolve_artifacts_dir(repo_root: Path, override: str | None) -> Path:
    """Resolve the configured artifact root without accepting an empty path."""
    if override and override.strip():
        return Path(override).expanduser().resolve()
    return default_artifacts_dir(repo_root)


def atomic_write(path: Path, content: str) -> None:
    """Atomically write a private UTF-8 artifact file."""
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    try:
        temporary.write_text(content, encoding="utf-8")
        temporary.chmod(0o600)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def artifact_reference_path(artifacts_dir: Path, reference: str) -> Path:
    """Resolve an artifact ID or explicit artifact directory."""
    explicit = Path(reference).expanduser()
    if (explicit.is_absolute() or len(explicit.parts) > 1) and explicit.exists():
        return explicit.resolve()
    if reference == "latest":
        latest = artifacts_dir / "latest"
        if not latest.is_file():
            raise ReviewError(f"No saved Claude review exists in {artifacts_dir}.")
        reference = latest.read_text(encoding="utf-8").strip()
    if not reference or Path(reference).name != reference:
        raise ReviewError("Review reference must be an artifact ID or existing path.")
    return artifacts_dir / reference


def load_review_artifact(
    artifacts_dir: Path,
    reference: str,
    *,
    repo_root: Path,
) -> tuple[dict[str, Any], dict[str, Any], Path]:
    """Load and validate a saved review from the same repository."""
    artifact_dir = artifact_reference_path(artifacts_dir, reference)
    metadata_path = artifact_dir / "metadata.json"
    review_path = artifact_dir / "review.json"
    for path in (metadata_path, review_path):
        if not path.is_file():
            raise ReviewError(f"Saved review is missing {path.name}: {artifact_dir}")
        if path.stat().st_size > MAX_ARTIFACT_BYTES:
            raise ReviewError(f"Saved review file is too large to load: {path}")
    try:
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        review = json.loads(review_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as error:
        raise ReviewError(f"Could not read saved review {artifact_dir}: {error}") from error
    if not isinstance(metadata, dict) or not isinstance(review, dict):
        raise ReviewError(f"Saved review has invalid JSON objects: {artifact_dir}")
    if Path(str(metadata.get("repository", ""))).resolve() != repo_root.resolve():
        raise ReviewError("Saved review belongs to a different repository.")
    validate_review(review)
    return metadata, review, artifact_dir


def review_with_finding_ids(
    review: dict[str, Any],
    *,
    reserved_ids: set[str] | None = None,
) -> dict[str, Any]:
    """Copy a review and add stable IDs for follow-up verification."""
    annotated = json.loads(json.dumps(review))
    finding_ids = [
        finding["id"]
        for finding in annotated.get("findings", [])
        if isinstance(finding.get("id"), str)
    ]
    if len(finding_ids) != len(set(finding_ids)):
        raise ReviewError("Saved review contains duplicate finding IDs.")
    used_ids = set(reserved_ids or ())
    used_ids.update(finding_ids)
    next_id = max((int(value[1:]) for value in used_ids), default=0) + 1
    for finding in annotated.get("findings", []):
        if "id" in finding:
            continue
        if next_id > 999:
            raise ReviewError("Saved review has too many findings to assign stable IDs.")
        while f"F{next_id:03d}" in used_ids:
            next_id += 1
        finding["id"] = f"F{next_id:03d}"
        used_ids.add(finding["id"])
        next_id += 1
    return annotated


def save_review_artifact(
    artifacts_dir: Path,
    *,
    repo_root: Path,
    review: dict[str, Any],
    scope: str,
    context: str,
    args: argparse.Namespace,
    started_at: str,
    previous_review_id: str | None,
    reserved_finding_ids: set[str] | None = None,
) -> tuple[str, Path]:
    """Persist a complete review atomically without storing the source diff."""
    context_digest = hashlib.sha256(context.encode("utf-8")).hexdigest()
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    base_id = f"{timestamp}-{context_digest[:8]}"
    artifacts_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    artifacts_dir.chmod(0o700)
    artifact_id = base_id
    suffix = 2
    while (artifacts_dir / artifact_id).exists():
        artifact_id = f"{base_id}-{suffix}"
        suffix += 1

    staging = artifacts_dir / f".{artifact_id}.tmp-{os.getpid()}"
    staging.mkdir(mode=0o700)
    try:
        head = run(["git", "rev-parse", "HEAD"], cwd=repo_root).stdout.strip()
        metadata = {
            "schema_version": ARTIFACT_SCHEMA_VERSION,
            "review_id": artifact_id,
            "reviewer": REVIEWER_ID,
            "repository": str(repo_root.resolve()),
            "head": head,
            "base": args.base,
            "scope": scope,
            "context_sha256": context_digest,
            "context_bytes": len(context.encode("utf-8")),
            "model": args.model or "default",
            "effort": args.effort,
            "focus": args.focus,
            "adversarial": args.adversarial,
            "allow_repo_read": args.allow_repo_read,
            "previous_review_id": previous_review_id,
            "started_at": started_at,
            "completed_at": utc_now(),
        }
        annotated = review_with_finding_ids(review, reserved_ids=reserved_finding_ids)
        for name, content in (
            ("metadata.json", json.dumps(metadata, indent=2) + "\n"),
            ("review.json", json.dumps(annotated, indent=2) + "\n"),
            ("report.md", render_markdown(annotated)),
        ):
            path = staging / name
            path.write_text(content, encoding="utf-8")
            path.chmod(0o600)
        staging.replace(artifacts_dir / artifact_id)
    finally:
        if staging.exists():
            shutil.rmtree(staging)
    atomic_write(artifacts_dir / "latest", artifact_id + "\n")
    return artifact_id, artifacts_dir / artifact_id


def run(
    command: Sequence[str],
    *,
    cwd: Path | None = None,
    input_text: str | None = None,
    check: bool = True,
    timeout: int | None = 120,
) -> subprocess.CompletedProcess[str]:
    """Run a subprocess without a shell."""
    try:
        process = subprocess.run(
            list(command),
            cwd=cwd,
            input=input_text,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise ReviewError(
            f"Command timed out after {timeout} seconds: {command[0]}"
        ) from error
    if check and process.returncode != 0:
        detail = (process.stderr or process.stdout).strip()
        raise ReviewError(detail or f"Command failed: {' '.join(command)}")
    return process


def format_duration(seconds: float) -> str:
    """Format elapsed seconds as a compact human-readable duration."""
    total_seconds = max(0, int(seconds))
    minutes, remaining_seconds = divmod(total_seconds, 60)
    if minutes:
        return f"{minutes}m {remaining_seconds:02d}s"
    return f"{remaining_seconds}s"


def emit_progress(stream: TextIO, message: str) -> None:
    """Write a flushed lifecycle update without contaminating review stdout."""
    print(f"[claude-review] {message}", file=stream, flush=True)


def progress_event(payload: dict[str, Any]) -> tuple[str, str] | None:
    """Return a deduplication key and safe message for a Claude stream event."""
    event_type = payload.get("type")
    if event_type == "system" and payload.get("subtype") == "init":
        model = payload.get("model")
        detail = f" using {model}" if isinstance(model, str) and model else ""
        return "initialized", f"Claude initialized{detail}."

    if event_type == "assistant":
        message = payload.get("message")
        if not isinstance(message, dict):
            return None
        content = message.get("content")
        if not isinstance(content, list):
            return None
        tool_names = [
            block.get("name")
            for block in content
            if isinstance(block, dict) and block.get("type") == "tool_use"
        ]
        for tool_name in tool_names:
            if isinstance(tool_name, str) and tool_name:
                if tool_name == "StructuredOutput":
                    return "finalizing", "Claude is finalizing the structured review."
                if tool_name in PROGRESS_TOOLS:
                    return (
                        f"tool:{tool_name}",
                        f"Claude is inspecting repository context with {tool_name}.",
                    )
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "text":
                return "drafting", "Claude is drafting the structured review."

    return None


def run_claude_stream(
    command: Sequence[str],
    *,
    cwd: Path,
    input_text: str,
    timeout: int,
    context_size: int,
    requested_model: str | None,
    effort: str | None,
    progress_stream: TextIO = sys.stderr,
) -> subprocess.CompletedProcess[str]:
    """Run Claude while forwarding safe lifecycle updates to progress_stream."""
    started_at = time.monotonic()
    process = subprocess.Popen(
        list(command),
        cwd=cwd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
        bufsize=1,
    )
    assert process.stdin is not None
    assert process.stdout is not None
    assert process.stderr is not None

    events: queue.Queue[tuple[str, str | None]] = queue.Queue()

    def read_stream(name: str, stream: TextIO) -> None:
        try:
            for line in stream:
                events.put((name, line))
        except (OSError, ValueError):
            pass
        finally:
            events.put((name, None))

    def write_stdin() -> None:
        try:
            process.stdin.write(input_text)
            process.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
        finally:
            try:
                process.stdin.close()
            except (BrokenPipeError, OSError):
                pass

    readers = [
        threading.Thread(
            target=read_stream,
            args=("stdout", process.stdout),
            daemon=True,
        ),
        threading.Thread(
            target=read_stream,
            args=("stderr", process.stderr),
            daemon=True,
        ),
    ]
    for reader in readers:
        reader.start()
    writer = threading.Thread(target=write_stdin, daemon=True)
    writer.start()

    deadline = started_at + timeout
    next_heartbeat = started_at + PROGRESS_INTERVAL_SECONDS
    model_text = requested_model or "Claude default"
    effort_text = f", {effort} effort" if effort else ""
    emit_progress(
        progress_stream,
        f"Started review with {model_text}{effort_text}; "
        f"context: {context_size:,} bytes.",
    )

    stdout_parts: list[str] = []
    stderr_parts: list[str] = []
    open_streams = {"stdout", "stderr"}
    emitted_events: set[str] = set()

    try:
        while open_streams:
            now = time.monotonic()
            if now >= deadline:
                process.kill()
                process.wait()
                raise ReviewError(
                    f"Command timed out after {timeout} seconds: {command[0]}"
                )

            if now >= next_heartbeat:
                emit_progress(
                    progress_stream,
                    "Claude is still reviewing; elapsed: "
                    f"{format_duration(now - started_at)}. No completion "
                    "estimate is available.",
                )
                next_heartbeat = now + PROGRESS_INTERVAL_SECONDS

            wait_seconds = max(0.0, min(deadline, next_heartbeat) - now)
            try:
                stream_name, line = events.get(timeout=wait_seconds)
            except queue.Empty:
                continue

            if line is None:
                open_streams.discard(stream_name)
                continue
            if stream_name == "stderr":
                stderr_parts.append(line)
                continue

            stdout_parts.append(line)
            try:
                payload = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(payload, dict):
                continue
            event = progress_event(payload)
            if event is None:
                continue
            event_key, message = event
            if event_key not in emitted_events:
                emitted_events.add(event_key)
                emit_progress(progress_stream, message)

        remaining_seconds = max(0.0, deadline - time.monotonic())
        try:
            process.wait(timeout=remaining_seconds)
        except subprocess.TimeoutExpired as error:
            process.kill()
            process.wait()
            raise ReviewError(
                f"Command timed out after {timeout} seconds: {command[0]}"
            ) from error
    finally:
        if process.poll() is None:
            process.kill()
            process.wait()
        writer.join(timeout=1)
        for reader in readers:
            reader.join(timeout=1)
        if not readers[0].is_alive():
            process.stdout.close()
        if not readers[1].is_alive():
            process.stderr.close()

    elapsed = time.monotonic() - started_at
    emit_progress(
        progress_stream,
        f"Claude review process finished after {format_duration(elapsed)}.",
    )
    return subprocess.CompletedProcess(
        args=list(command),
        returncode=process.returncode,
        stdout="".join(stdout_parts),
        stderr="".join(stderr_parts),
    )


def find_repo_root(start: Path) -> Path:
    """Return the Git repository root containing start."""
    result = run(["git", "rev-parse", "--show-toplevel"], cwd=start)
    return Path(result.stdout.strip()).resolve()


def validate_base(repo_root: Path, base: str) -> None:
    """Reject a base ref that Git cannot resolve to a commit."""
    run(["git", "rev-parse", "--verify", f"{base}^{{commit}}"], cwd=repo_root)


def collect_review_context(
    repo_root: Path,
    *,
    base: str | None,
    max_diff_bytes: int,
) -> tuple[str, str]:
    """Collect a bounded Git diff and return its human-readable scope."""
    if base:
        validate_base(repo_root, base)
        merge_base = run(["git", "merge-base", base, "HEAD"], cwd=repo_root).stdout.strip()
        scope = f"committed branch changes from merge-base {merge_base} ({base}...HEAD)"
        status = run(
            [
                "git",
                "diff",
                "--name-status",
                "--find-renames",
                f"{merge_base}..HEAD",
                "--",
                *REVIEW_PATHS,
            ],
            cwd=repo_root,
        ).stdout
        diff = run(
            [
                "git",
                "diff",
                "--no-ext-diff",
                "--find-renames",
                "--unified=40",
                f"{merge_base}..HEAD",
                "--",
                *REVIEW_PATHS,
            ],
            cwd=repo_root,
        ).stdout
    else:
        scope = "current staged, unstaged, and untracked working-tree changes"
        status = run(
            [
                "git",
                "status",
                "--short",
                "--untracked-files=all",
                "--",
                *REVIEW_PATHS,
            ],
            cwd=repo_root,
        ).stdout
        unstaged = run(
            [
                "git",
                "diff",
                "--no-ext-diff",
                "--find-renames",
                "--unified=40",
                "--",
                *REVIEW_PATHS,
            ],
            cwd=repo_root,
        ).stdout
        staged = run(
            [
                "git",
                "diff",
                "--cached",
                "--no-ext-diff",
                "--find-renames",
                "--unified=40",
                "--",
                *REVIEW_PATHS,
            ],
            cwd=repo_root,
        ).stdout
        diff = "\n".join(
            section
            for section in (
                "## Unstaged diff\n" + unstaged if unstaged else "",
                "## Staged diff\n" + staged if staged else "",
            )
            if section
        )

    if not status.strip():
        raise ReviewError(f"No changes found for {scope}.")

    context = (
        "## Git status / changed paths\n"
        f"{status}\n"
        "Common secret-bearing paths are excluded from both this list and the "
        "supplied diff.\n\n"
        "## Diff\n"
        f"{diff or '(No textual diff; inspect listed untracked or binary files.)'}"
    )
    context_size = len(context.encode("utf-8"))
    if context_size > max_diff_bytes:
        raise ReviewError(
            f"Review context is {context_size:,} bytes, above the "
            f"{max_diff_bytes:,}-byte safety limit. Narrow the change or pass "
            "--max-diff-bytes with an intentional larger value."
        )
    return scope, context


def build_prompt(
    *,
    repo_root: Path,
    scope: str,
    context: str,
    adversarial: bool,
    focus: str | None,
    allow_repo_read: bool,
    previous_review: tuple[dict[str, Any], dict[str, Any]] | None = None,
) -> str:
    """Build the Claude reviewer prompt."""
    mode = (
        "Act as an adversarial reviewer. Pressure-test the chosen design, hidden "
        "assumptions, failure modes, and whether a simpler or safer approach exists."
        if adversarial
        else "Act as a pragmatic senior code reviewer."
    )
    focus_text = focus.strip() if focus and focus.strip() else "No additional focus."
    context_access = (
        "You may use Read, Glob, and Grep for surrounding repository context. "
        "Never inspect secret-bearing paths."
        if allow_repo_read
        else "Do not use repository tools. Review only the supplied diff context."
    )
    follow_up_text = ""
    if previous_review:
        metadata, review = previous_review
        follow_up_text = f"""

Follow-up verification:
- Previous review ID: {metadata.get('review_id', 'unknown')}
- Previous reviewed HEAD: {metadata.get('head', 'unknown')}
- Previous context SHA-256: {metadata.get('context_sha256', 'unknown')}
- Verify every previous finding against the current checkout.
- Reuse its finding ID when a problem remains. Do not repeat resolved findings as new findings.
- State the disposition of every previous finding in the summary: resolved,
  partially resolved, not resolved, or superseded.

Previous structured review:
{json.dumps(review, indent=2)}
"""
    return f"""You are an independent reviewer. {mode}

Repository: {repo_root}
Review scope: {scope}
Focus: {focus_text}

Hard constraints:
- This is a read-only review. Never edit files or suggest that you edited them.
- {context_access}
- Do not open or quote secrets, credentials, private keys, .env files, or auth tokens.
- Report only actionable correctness, security, reliability, performance, or
  maintainability problems introduced by this change.
- Do not report style preferences, generic best practices, or pre-existing issues.
- Verify each finding against surrounding code before reporting it.
- Use repository-relative file paths and the tightest relevant line number.
- In evidence, include the nearest heading, symbol, or stable text anchor because line numbers move.
- Distinguish confirmed contradictions, unsafe ambiguity, missing contracts, and editorial notes;
  do not elevate optional improvements into required changes.
- If evidence is incomplete, lower confidence or put it in coverage_gaps instead.
{follow_up_text}

Return the requested structured review with findings ordered by severity.

{context}
"""


def build_claude_command(args: argparse.Namespace) -> list[str]:
    """Build the Claude CLI command with a strict read-only tool allowlist."""
    command = [
        args.claude_binary,
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--json-schema",
        json.dumps(REVIEW_SCHEMA, separators=(",", ":")),
        "--permission-mode",
        "plan",
        "--tools",
        READ_ONLY_TOOLS if args.allow_repo_read else "",
        "--safe-mode",
        "--no-chrome",
        "--no-session-persistence",
        "--max-budget-usd",
        str(args.max_budget_usd),
    ]
    if args.model:
        command.extend(["--model", args.model])
    if args.effort:
        command.extend(["--effort", args.effort])
    return command


def validate_review(review: dict[str, Any]) -> dict[str, Any]:
    """Validate Claude output before it reaches the renderer."""
    required = REVIEW_SCHEMA["required"]
    missing = [key for key in required if key not in review]
    if missing:
        raise ReviewError(
            f"Claude review is missing required fields: {', '.join(missing)}"
        )
    if review["verdict"] not in {"approve", "approve_with_notes", "request_changes"}:
        raise ReviewError("Claude review has an invalid verdict.")
    if not isinstance(review["summary"], str):
        raise ReviewError("Claude review field 'summary' must be a string.")
    for field in ("findings", "coverage_gaps", "next_steps"):
        if not isinstance(review[field], list):
            raise ReviewError(f"Claude review field '{field}' must be an array.")
    for field in ("coverage_gaps", "next_steps"):
        if not all(isinstance(item, str) for item in review[field]):
            raise ReviewError(f"Claude review field '{field}' must contain strings.")

    finding_fields = {
        "severity",
        "title",
        "file",
        "line",
        "evidence",
        "recommendation",
        "confidence",
    }
    for index, finding in enumerate(review["findings"]):
        if not isinstance(finding, dict):
            raise ReviewError(f"Claude finding {index + 1} must be an object.")
        missing_finding = finding_fields - finding.keys()
        if missing_finding:
            raise ReviewError(
                f"Claude finding {index + 1} is missing fields: "
                f"{', '.join(sorted(missing_finding))}"
            )
        if finding["severity"] not in {"blocker", "high", "medium", "low"}:
            raise ReviewError(f"Claude finding {index + 1} has invalid severity.")
        if finding["confidence"] not in {"high", "medium", "low"}:
            raise ReviewError(f"Claude finding {index + 1} has invalid confidence.")
        finding_id = finding.get("id")
        if finding_id is not None and (
            not isinstance(finding_id, str)
            or len(finding_id) != 4
            or not finding_id.startswith("F")
            or not finding_id[1:].isdigit()
        ):
            raise ReviewError(f"Claude finding {index + 1} has invalid ID.")
        for field in ("title", "file", "evidence", "recommendation"):
            if not isinstance(finding[field], str):
                raise ReviewError(
                    f"Claude finding {index + 1} field '{field}' must be a string."
                )
        line = finding["line"]
        if line is not None and (
            not isinstance(line, int) or isinstance(line, bool) or line < 1
        ):
            raise ReviewError(
                f"Claude finding {index + 1} field 'line' must be null or positive."
            )
    return review


def extract_review(stdout: str) -> dict[str, Any]:
    """Extract structured output from Claude's JSON envelope."""
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError as error:
        raise ReviewError(f"Claude returned invalid JSON: {error}") from error

    if isinstance(payload, dict):
        structured = payload.get("structured_output")
        if isinstance(structured, dict):
            return validate_review(structured)

        result = payload.get("result")
        if isinstance(result, dict):
            return validate_review(result)
        if isinstance(result, str):
            try:
                decoded = json.loads(result)
            except json.JSONDecodeError:
                decoded = None
            if isinstance(decoded, dict):
                return validate_review(decoded)

        if all(key in payload for key in REVIEW_SCHEMA["required"]):
            return validate_review(payload)

    raise ReviewError("Claude did not return the expected structured review.")


def extract_stream_review(stdout: str) -> dict[str, Any]:
    """Extract the final structured review from Claude stream-json output."""
    lines = [line for line in stdout.splitlines() if line.strip()]
    for line in reversed(lines):
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, dict) and payload.get("type") == "result":
            return extract_review(line)

    if len(lines) == 1:
        # Retain compatibility with fake or older Claude binaries returning one
        # ordinary JSON envelope despite the requested stream output format.
        return extract_review(lines[0])
    raise ReviewError(
        "Claude stream ended before returning a final result event."
    )


def failure_detail(stderr: str, stdout: str) -> str:
    """Return a bounded Claude error without exposing its verbose stdout stream."""
    detail = stderr.strip()
    if detail:
        return detail[-4_000:]

    for line in reversed(stdout.splitlines()):
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict) or payload.get("type") != "result":
            continue
        subtype = payload.get("subtype")
        error_result = payload.get("result")
        label = subtype if isinstance(subtype, str) and subtype else "error"
        if isinstance(error_result, str) and error_result.strip():
            return f"Claude review failed ({label}): {error_result.strip()[-1_000:]}"
        return f"Claude review failed ({label})."
    return "Claude review failed without an error message."


def render_markdown(review: dict[str, Any]) -> str:
    """Render structured review data for a human."""
    lines = [
        f"# Claude review: {str(review['verdict']).replace('_', ' ')}",
        "",
        str(review["summary"]).strip(),
    ]
    findings = review.get("findings", [])
    if findings:
        lines.extend(["", "## Findings"])
        for finding in findings:
            location = str(finding["file"])
            if finding.get("line"):
                location += f":{finding['line']}"
            finding_id = f"[{finding['id']}] " if finding.get("id") else ""
            lines.extend(
                [
                    "",
                    f"- [{str(finding['severity']).upper()}] {finding_id}{finding['title']} "
                    f"({location}, confidence: {finding['confidence']})",
                    f"  Evidence: {finding['evidence']}",
                    f"  Recommendation: {finding['recommendation']}",
                ]
            )
    else:
        lines.extend(["", "No actionable findings."])

    coverage_gaps = review.get("coverage_gaps", [])
    if coverage_gaps:
        lines.extend(["", "## Coverage gaps"])
        lines.extend(f"- {gap}" for gap in coverage_gaps)

    next_steps = review.get("next_steps", [])
    if next_steps:
        lines.extend(["", "## Suggested next steps"])
        lines.extend(f"- {step}" for step in next_steps)
    return "\n".join(lines).rstrip() + "\n"


def check_claude(binary: str) -> int:
    """Report Claude CLI installation and authentication status."""
    resolved = shutil.which(binary)
    if not resolved:
        print(
            "Claude Code CLI was not found. Install it, then run `claude auth login`.",
            file=sys.stderr,
        )
        return 1

    version = run([resolved, "--version"], check=False)
    print(f"Claude CLI: {(version.stdout or version.stderr).strip()}")
    auth = run([resolved, "auth", "status"], check=False)
    output = (auth.stdout or auth.stderr).strip()
    try:
        status = json.loads(output)
    except json.JSONDecodeError:
        status = {}
    if auth.returncode != 0 or status.get("loggedIn") is not True:
        print("Claude authentication: not logged in")
        if sys.platform == "darwin":
            print(
                "If this check ran inside the Codex sandbox, retry the exact "
                "command with scoped sandbox escalation so Claude can access "
                "macOS Login Keychain.",
                file=sys.stderr,
            )
            print(
                "If it still fails outside the sandbox, run `claude auth login` "
                "in a terminal, then retry.",
                file=sys.stderr,
            )
        else:
            print("Run `claude auth login` in a terminal, then retry.", file=sys.stderr)
        return 1
    print(f"Claude authentication: ready ({status.get('authMethod', 'unknown')})")
    return 0


def positive_int(value: str) -> int:
    """Parse a strictly positive integer."""
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return parsed


def positive_float(value: str) -> float:
    """Parse a strictly positive number."""
    parsed = float(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return parsed


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Ask Claude for a structured, read-only review of Git changes."
    )
    parser.add_argument("--base", help="Review committed branch changes against this ref.")
    parser.add_argument("--focus", help="Focus the review on a specific risk or question.")
    parser.add_argument(
        "--adversarial",
        action="store_true",
        help="Challenge design choices, assumptions, and failure modes.",
    )
    parser.add_argument("--model", help="Optional Claude model or alias.")
    parser.add_argument(
        "--effort",
        choices=["low", "medium", "high", "xhigh", "max"],
        help="Optional Claude reasoning effort.",
    )
    parser.add_argument("--json", action="store_true", help="Print structured JSON.")
    parser.add_argument(
        "--follow-up",
        metavar="REVIEW",
        help="Verify a saved review ID or artifact directory against current changes.",
    )
    parser.add_argument(
        "--show-review",
        metavar="REVIEW",
        help="Print a saved review ID (or 'latest') without contacting Claude.",
    )
    parser.add_argument(
        "--artifacts-dir",
        help="Override the default .git/codex-reviews/claude artifact directory.",
    )
    parser.add_argument(
        "--no-save-review",
        action="store_true",
        help="Do not persist the completed review as a local Git artifact.",
    )
    parser.add_argument(
        "--max-diff-bytes",
        type=positive_int,
        default=DEFAULT_MAX_DIFF_BYTES,
        help=f"Maximum review context size (default: {DEFAULT_MAX_DIFF_BYTES}).",
    )
    parser.add_argument(
        "--allow-repo-read",
        action="store_true",
        help="Allow Claude to inspect repository files beyond the supplied diff.",
    )
    parser.add_argument(
        "--max-budget-usd",
        type=positive_float,
        default=DEFAULT_MAX_BUDGET_USD,
        help=f"Maximum Claude API budget (default: {DEFAULT_MAX_BUDGET_USD}).",
    )
    parser.add_argument(
        "--timeout-seconds",
        type=positive_int,
        default=DEFAULT_TIMEOUT_SECONDS,
        help=f"Maximum review runtime (default: {DEFAULT_TIMEOUT_SECONDS}).",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check Claude installation and authentication without reviewing.",
    )
    parser.add_argument(
        "--claude-binary",
        default=os.environ.get("CLAUDE_FOR_CODEX_BINARY", "claude"),
        help=argparse.SUPPRESS,
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    """Run setup diagnostics or a Claude review."""
    args = parse_args(argv)
    if args.check:
        return check_claude(args.claude_binary)
    if args.follow_up and args.show_review:
        raise ReviewError("--follow-up and --show-review cannot be used together.")

    repo_root = find_repo_root(Path.cwd())
    if args.show_review:
        artifacts_dir = resolve_artifacts_dir(repo_root, args.artifacts_dir)
        _, review, artifact_dir = load_review_artifact(
            artifacts_dir,
            args.show_review,
            repo_root=repo_root,
        )
        if args.json:
            print(json.dumps(review, indent=2))
        else:
            report = artifact_dir / "report.md"
            print(report.read_text(encoding="utf-8"), end="")
        return 0

    previous_metadata = None
    previous_review = None
    previous_review_id = None
    reserved_finding_ids: set[str] = set()
    artifacts_dir = None
    if args.follow_up:
        artifacts_dir = resolve_artifacts_dir(repo_root, args.artifacts_dir)
        previous_metadata, previous_review, _ = load_review_artifact(
            artifacts_dir,
            args.follow_up,
            repo_root=repo_root,
        )
        previous_review_id = str(previous_metadata.get("review_id", "")) or None
        if len(json.dumps(previous_review).encode("utf-8")) > MAX_FOLLOW_UP_REVIEW_BYTES:
            raise ReviewError("Saved review is too large to use as follow-up context.")
        reserved_finding_ids = {
            finding["id"]
            for finding in previous_review.get("findings", [])
            if isinstance(finding.get("id"), str)
        }
        if args.base is None and isinstance(previous_metadata.get("base"), str):
            args.base = previous_metadata["base"]

    resolved = shutil.which(args.claude_binary)
    if not resolved:
        raise ReviewError(
            "Claude Code CLI was not found. Install it and run `claude auth login`."
        )
    args.claude_binary = resolved

    scope, context = collect_review_context(
        repo_root,
        base=args.base,
        max_diff_bytes=args.max_diff_bytes,
    )
    if artifacts_dir is None and not args.no_save_review:
        artifacts_dir = resolve_artifacts_dir(repo_root, args.artifacts_dir)
    prompt = build_prompt(
        repo_root=repo_root,
        scope=scope,
        context=context,
        adversarial=args.adversarial,
        focus=args.focus,
        allow_repo_read=args.allow_repo_read,
        previous_review=(previous_metadata, previous_review)
        if previous_metadata is not None and previous_review is not None
        else None,
    )
    started_at = utc_now()
    result = run_claude_stream(
        build_claude_command(args),
        cwd=repo_root,
        input_text=prompt,
        timeout=args.timeout_seconds,
        context_size=len(context.encode("utf-8")),
        requested_model=args.model,
        effort=args.effort,
    )
    if result.returncode != 0:
        raise ReviewError(failure_detail(result.stderr, result.stdout))

    review = extract_stream_review(result.stdout)
    if not args.no_save_review:
        assert artifacts_dir is not None
        try:
            artifact_id, artifact_dir = save_review_artifact(
                artifacts_dir,
                repo_root=repo_root,
                review=review,
                scope=scope,
                context=context,
                args=args,
                started_at=started_at,
                previous_review_id=previous_review_id,
                reserved_finding_ids=reserved_finding_ids,
            )
        except (OSError, ReviewError) as error:
            emit_progress(
                sys.stderr,
                f"Warning: could not save review artifact: {error}",
            )
        else:
            emit_progress(
                sys.stderr,
                f"Saved review {artifact_id} to {artifact_dir}",
            )
    if args.json:
        print(json.dumps(review, indent=2))
    else:
        print(render_markdown(review), end="")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ReviewError as error:
        print(f"claude-review: {error}", file=sys.stderr)
        raise SystemExit(2) from error
